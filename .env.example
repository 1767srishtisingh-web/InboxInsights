# Google OAuth 2.0 (Required for real Gmail access)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Twilio WhatsApp (Optional - leave empty for Demo Mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=

# Optional: Public URL to serve PDF reports (needed for Twilio media)
# PUBLIC_REPORT_URL=https://your-domain.com/reports

# Scheduler defaults (can be overridden per-user via dashboard)
REPORT_TIME=20:00
TIMEZONE=Asia/Kolkata

# App
PORT=3000
